# Copy to .env and fill in. Never commit the real .env.

# Local development
DATABASE_URL=postgresql://phf:phf@localhost:5432/phf_erp
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
CORS_ORIGINS=http://localhost:5173
# Where people open the app, for links inside emails and messages
APP_URL=http://localhost:5173
# Encrypts email/WhatsApp/SMS passwords and tokens in the database (32+ characters, openssl rand -base64 48).
# Keep it with your backups: without it the saved channel passwords cannot be read. If unset, JWT_SECRET is used.
SECRETS_KEY=
# How often alerts are looked for and queued messages are sent (seconds; 0 = off)
NOTIFY_INTERVAL_SECONDS=300

# Server (docker compose)
DB_PASSWORD=change-me
API_DOMAIN=api.erp.example.org
BOOTSTRAP_ADMIN_EMAIL=it@kphfs.org
