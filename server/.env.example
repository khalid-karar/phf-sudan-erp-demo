# Copy to .env and fill in. Never commit the real .env.

# Local development
DATABASE_URL=postgresql://phf:phf@localhost:5432/phf_erp
# At least 32 random characters. Use letters and digits only: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
CORS_ORIGINS=http://localhost:5173
# Where people open the app, for links inside emails and messages
APP_URL=http://localhost:5173
# Encrypts email/WhatsApp/SMS passwords and tokens in the database (32+ characters: openssl rand -hex 32).
# REQUIRED in production. Keep it with your backups: without it the saved channel passwords cannot be read.
SECRETS_KEY=
# Largest file that can be uploaded (megabytes)
MAX_UPLOAD_MB=10
# Local development only: where uploaded files are kept
UPLOAD_DIR=./uploads
# How often alerts are looked for and queued messages are sent (seconds; 0 = off)
NOTIFY_INTERVAL_SECONDS=300

# Server (docker compose)
# Letters and digits only (it goes inside a connection URL): openssl rand -hex 24
DB_PASSWORD=change-me
# The one address people open (app and API share it), e.g. erp.phfsudan.org
APP_DOMAIN=erp.example.org
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# Optional: today's SDG per USD rate, so the first payment works straight away
BOOTSTRAP_SDG_RATE=
